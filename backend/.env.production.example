APP_NAME="Penta Tri Saka Operations"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=penta_trisaka
DB_USERNAME=penta
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Foto disimpan di storage/app/public (butuh `php artisan storage:link`).
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# Wajib diisi sebelum `php artisan db:seed --class=ProductionSeeder`.
# Password minimal 12 karakter.
OWNER_EMAIL=owner@domain-anda.com
OWNER_PASSWORD=
OWNER_NAME="Owner"

# Daftar origin frontend yang boleh akses API, pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=https://app.domain-anda.com
